#    BR=$(ffprobe -v quiet -show_entries format=bit_rate -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null)
#    if [[ "$BR" =~ ^[0-9]+$ ]]; then
#      ALBUM_BITRATE_SUM[$ALBUM]=$(( ${ALBUM_BITRATE_SUM[$ALBUM]} + BR ))
#      ALBUM_BITRATE_N[$ALBUM]=$(( ${ALBUM_BITRATE_N[$ALBUM]} + 1 ))
#    fi
#  done < <(find "$ROOT/$ALBUM" -maxdepth 1 -type f -iname "*.mp3")
#done

mapfile -t SORTED_ARTISTS < <(for a in "${!ARTIST_BYTES[@]}"; do echo "$a"; done | sort)

for ARTIST in "${SORTED_ARTISTS[@]}"; do
  A_MB=$(awk "BEGIN { printf \"%.2f\", ${ARTIST_BYTES[$ARTIST]} / 1048576 }")
  printf "\n  %-50s %5d files  %8s MB\n" "$ARTIST" "${ARTIST_COUNT[$ARTIST]}" "$A_MB"

  mapfile -t SORTED_ALBUMS < <(for alb in "${!ALBUM_BYTES[@]}"; do
    [[ "$alb" == "$ARTIST/"* ]] && echo "$alb"
  done | sort)

  for ALBUM in "${SORTED_ALBUMS[@]}"; do
    ALBUM_NAME="${ALBUM#$ARTIST/}"
    ALB_MB=$(awk "BEGIN { printf \"%.2f\", ${ALBUM_BYTES[$ALBUM]} / 1048576 }")
    N=${ALBUM_BITRATE_N[$ALBUM]:-0}
    if [[ $N -gt 0 ]]; then
      AVG_KBPS=$(awk "BEGIN { printf \"%d\", ${ALBUM_BITRATE_SUM[$ALBUM]} / $N / 1000 }")
      BITRATE_STR="${AVG_KBPS} kbps"
    else
      BITRATE_STR="N/A"
    fi
    printf "    %-48s %5d files  %8s MB  %s\n" "$ALBUM_NAME" "${ALBUM_COUNT[$ALBUM]}" "$ALB_MB" "$BITRATE_STR"
  done
done

echo ""
