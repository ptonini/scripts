#!/bin/bash

ROOT="/home/ptonini/NFS/media/musicas_01"

mapfile -t MP3_FILES < <(find "$ROOT" -type f -iname "*.mp3")

COUNT=${#MP3_FILES[@]}

if [[ $COUNT -eq 0 ]]; then
  echo "No MP3 files found."
  exit 0
fi

TOTAL_BYTES=0
declare -A ARTIST_BYTES
declare -A ARTIST_COUNT
declare -A ALBUM_BYTES
declare -A ALBUM_COUNT
declare -A ALBUM_BITRATE_SUM
declare -A ALBUM_BITRATE_N

for f in "${MP3_FILES[@]}"; do
  SIZE=$(stat -c%s "$f")
  TOTAL_BYTES=$((TOTAL_BYTES + SIZE))

  RELATIVE="${f#$ROOT/}"
  ARTIST=$(echo "$RELATIVE" | cut -d'/' -f1)
  ALBUM=$(echo "$RELATIVE" | cut -d'/' -f1-2)

  ARTIST_BYTES[$ARTIST]=$(( ${ARTIST_BYTES[$ARTIST]:-0} + SIZE ))
  ARTIST_COUNT[$ARTIST]=$(( ${ARTIST_COUNT[$ARTIST]:-0} + 1 ))
  ALBUM_BYTES[$ALBUM]=$(( ${ALBUM_BYTES[$ALBUM]:-0} + SIZE ))
  ALBUM_COUNT[$ALBUM]=$(( ${ALBUM_COUNT[$ALBUM]:-0} + 1 ))
  ALBUM_BITRATE_SUM[$ALBUM]=$(( ${ALBUM_BITRATE_SUM[$ALBUM]:-0} ))
  ALBUM_BITRATE_N[$ALBUM]=$(( ${ALBUM_BITRATE_N[$ALBUM]:-0} ))
done

TOTAL_MB=$(awk "BEGIN { printf \"%.2f\", $TOTAL_BYTES / 1048576 }")
TOTAL_GB=$(awk "BEGIN { printf \"%.2f\", $TOTAL_BYTES / 1073741824 }")

TOTAL_ARTISTS=${#ARTIST_BYTES[@]}
TOTAL_ALBUMS=${#ALBUM_BYTES[@]}

echo "Artists found   : $TOTAL_ARTISTS"
echo "Albums found    : $TOTAL_ALBUMS"
echo "MP3 files found : $COUNT"
echo "Total size      : ${TOTAL_MB} MB (${TOTAL_GB} GB)"
echo ""

read -rp "Show detailed info? [y/N] " CONFIRM
[[ "$CONFIRM" =~ ^[Yy]$ ]] || exit 0

echo ""
