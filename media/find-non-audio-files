#!/bin/bash

ROOT="/home/ptonini/NFS/media/musicas_01"
AUDIO_EXTENSIONS="mp3|flac|wav|aac|ogg|m4a|wma|opus|ape|alac|aiff"

mapfile -t NON_AUDIO_FILES < <(
  find "$ROOT" -mindepth 2 -maxdepth 3 -type f | grep -viE "\.($AUDIO_EXTENSIONS)$"
)

if [[ ${#NON_AUDIO_FILES[@]} -eq 0 ]]; then
  echo "No non-audio files found."
  exit 0
fi

echo "The following non-audio files were found:"
echo ""y
for f in "${NON_AUDIO_FILES[@]}"; do
  echo "  $f"
done
echo ""

read -rp "Delete all ${#NON_AUDIO_FILES[@]} file(s)? [y/N] " CONFIRM
if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
  for f in "${NON_AUDIO_FILES[@]}"; do
    rm -f "$f"
    echo "Deleted: $f"
  done
  echo "Done."
else
  echo "Aborted."
fi
